rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function memberStatus(groupId, uid) {
      let path = /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
      return exists(path) ? get(path).data.status : null;
    }

    function isAdminOf(groupId) {
      return isSignedIn()
        && groupDoc(groupId).data.adminId == request.auth.uid;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && memberStatus(groupId, request.auth.uid) in ['approved', 'pending'];
    }

    function canReadGroup(groupId) {
      return isAdminOf(groupId) || isGroupMember(groupId);
    }

    // A targeted invite is valid when it exists, points at this group, and was
    // addressed to the signed-in user's email.
    function inviteMatches(groupId, code) {
      return code is string
        && code.size() > 0
        && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.groupId == groupId
        && get(/databases/$(database)/documents/invites/$(code)).data.get('inviteeEmail', '') == request.auth.token.email.lower();
    }

    function rotationNotStarted(groupId) {
      return groupDoc(groupId).data.get('currentCycleRecipientId', null) == null;
    }

    // users/{uid} — users manage only their own profile
    match /users/{uid} {
      allow read, update, delete: if isSelf(uid);
      allow create: if isSelf(uid);
    }

    // invites/{code} — public resolution of an invite code to a group
    match /invites/{code} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.groupId != null                                                                                                                                                                                                                                                                                                   
        && isAdminOf(request.resource.data.groupId);
      allow update, delete: if isSignedIn()
        && resource.data.groupId != null
        && isAdminOf(resource.data.groupId);
    }

    // groups — members/admin can read; only the admin writes; creation is open to signed-in users
    match /groups/{groupId} {
      // list query: admins may list their own groups (where adminId == uid)
      allow read: if isSignedIn() && resource.data.adminId == request.auth.uid;
      // single-doc get: members and admins may read a specific group
      allow read: if canReadGroup(groupId);
      allow create: if isSignedIn();
      allow update: if isAdminOf(groupId)
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingCount'])
          && request.resource.data.pendingCount == resource.data.pendingCount + 1
          && memberStatus(groupId, request.auth.uid) == 'pending'
        )
        || (
          // Targeted invite auto-join: the joiner bumps the group totals in the
          // same batch that makes their (new) member doc approved.
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalMembers', 'totalSlots', 'pendingCount'])
          && memberStatus(groupId, request.auth.uid) != 'approved'
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == 'approved'
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.userId == request.auth.uid
        );
      allow delete: if isAdminOf(groupId);

      match /members/{memberId} {
        allow read: if canReadGroup(groupId)
          || (isSignedIn() && memberId == request.auth.uid);
        // members may submit a pending self-join request via an invite link,
        // or auto-join as approved via an invite addressed to their email
        allow create: if isAdminOf(groupId)
          || (
            isSignedIn()
            && memberId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'pending'
            && rotationNotStarted(groupId)
          )
          || (
            isSignedIn()
            && memberId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'approved'
            && inviteMatches(groupId, request.resource.data.get('inviteCode', ''))
            && rotationNotStarted(groupId)
          );
        allow update: if isAdminOf(groupId)
          || (
            isSignedIn()
            && memberId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          )
          || (
            isSignedIn()
            && memberId == request.auth.uid
            && request.resource.data.status == 'approved'
            && inviteMatches(groupId, request.resource.data.get('inviteCode', ''))
            && rotationNotStarted(groupId)
          );
        allow delete: if false;
      }

      match /contributions/{contributionId} {
        allow read: if canReadGroup(groupId);
        allow create, update: if isAdminOf(groupId);
        allow delete: if false;
      }

      match /cycles/{cycleId} {
        allow read: if canReadGroup(groupId);
        allow create, update: if isAdminOf(groupId);
        allow delete: if false;
      }
    }

    // notifications — users read/update their own; admins may create for their groups
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        &&             request.resource.data.type in ['paid', 'your_turn', 'new_cycle', 'approved', 'reminder']
        && (
          request.resource.data.userId == request.auth.uid
          || isAdminOf(request.resource.data.groupId)
        );
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
